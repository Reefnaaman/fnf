# F&F environment. Rendered into <repo>/.env by deploy/fnf/setup.sh; the agent's launchd
# service sources it. Secrets live here and nowhere else. Never commit this file.

# ----- Model ----------------------------------------------------------------------------
INSTINCT_MODEL=anthropic/claude-fable-5-1
ANTHROPIC_API_KEY=
# Optional: voice notes are transcribed with OpenAI when set.
OPENAI_API_KEY=

# ----- Owner ----------------------------------------------------------------------------
INSTINCT_OWNER_NAME=Reef
# Your personal WhatsApp number, E.164 (+972...). Required: it is how the owner chat is trusted.
INSTINCT_OWNER_PHONE=
INSTINCT_OWNER_TIMEZONE=Asia/Jerusalem
INSTINCT_AGENT_NAME="F&F"

# ----- Runtime --------------------------------------------------------------------------
INSTINCT_DATA_DIR="__REPO__/.instinct"
INSTINCT_SKILLS_DIR="__REPO__/skills"
INSTINCT_COMPUTER=none
INSTINCT_ACK_SLOW_REPLIES=1
INSTINCT_BIND=127.0.0.1
PORT=8080
# Bearer token for /chat, /status and /schedules. setup.sh fills it in.
INSTINCT_CHAT_TOKEN=

# ----- WhatsApp (F&F's own daemon copy at <repo>/daemon) -----------------------------
FNF_WHATSAPP_SOCKET="__REPO__/daemon/control.sock"
# The owner's chat id on F&F's account, as `daemon/bin/wa chats` prints it. `fnfctl.sh owner-chat` fills it in.
FNF_WHATSAPP_OWNER_CHAT=

# ----- Apps (optional) ------------------------------------------------------------------
# Gmail, Google Calendar and Contacts through Composio. Leave empty to run without apps.
COMPOSIO_API_KEY=
